"""
setup_feast.py

Registers the feature definitions in features_repo/card_features.py,
materializes them into the online store, and runs a sanity lookup.

Run from the project root:
    python feature_store/setup_feast.py
"""

import logging
import sys
from pathlib import Path

import pandas as pd
import pyarrow.parquet as pq
from feast import FeatureStore

logger = logging.getLogger(__name__)

HERE = Path(__file__).resolve().parent
REPO_DIR = HERE / "features_repo"

sys.path.insert(0, str(REPO_DIR))
# Your existing definitions. Change "card_features" if your file is named differently.
from features_repo.card_features import uid, source, fraud_features  # noqa: E402

# Everything below is derived from card_features.py, so nothing is duplicated here.
FEATURE_COLUMNS = [f.name for f in fraud_features.features]
FEATURE_VIEW_NAME = fraud_features.name  # "fraud_features"
PARQUET_PATH = REPO_DIR / "fraud_transaction.parquet"


def load_source() -> pd.DataFrame:
    """Read the columns the feature view needs; fails loudly if any are missing."""
    declared = (REPO_DIR / source.path).resolve()
    if declared != PARQUET_PATH.resolve():
        raise ValueError(
            f"card_features.py points at {declared}, but the parquet is {PARQUET_PATH}. "
            'Set FileSource(path="fraud_transaction.parquet", ...) in card_features.py.'
        )
    if not PARQUET_PATH.exists():
        raise FileNotFoundError(
            f"Feature source not found: {PARQUET_PATH}. Run build_feature.py first."
        )

    wanted = ["uid", "event_timestamp"] + FEATURE_COLUMNS
    available = set(pq.read_schema(PARQUET_PATH).names)
    missing = [c for c in wanted if c not in available]
    if missing:
        raise ValueError(
            f"Parquet is missing {len(missing)} column(s): {missing}. "
            "Add them in build_feature.py (event_timestamp is required by Feast)."
        )

    df = pd.read_parquet(PARQUET_PATH, columns=wanted)
    df["event_timestamp"] = pd.to_datetime(df["event_timestamp"], utc=True)
    if df["uid"].dtype != "object":
        logger.warning("uid is %s, expected string. Save it with astype(str).", df["uid"].dtype)
    return df


def main() -> None:
    logging.basicConfig(level=logging.INFO)

    df = load_source()
    logger.info(f"Source has {len(df):,} rows, {df['uid'].nunique():,} uids, {len(FEATURE_COLUMNS)} features")

    store = FeatureStore(repo_path=str(REPO_DIR))
    store.apply([uid, fraud_features])
    logger.info("Registered entity and feature view")

    start = df["event_timestamp"].min().to_pydatetime()
    end = (df["event_timestamp"].max() + pd.Timedelta(seconds=1)).to_pydatetime()
    store.materialize(start_date=start, end_date=end)
    logger.info("Materialized features into the online store")

    sample_uid = str(df["uid"].iloc[0])
    sample_cols = ["TransactionAmt", "zscore_uid", "txn_count_1h", "txn_amt_sum_24h", "device_proxy"]
    sample_cols = [c for c in sample_cols if c in FEATURE_COLUMNS]
    online = store.get_online_features(
        features=[f"{FEATURE_VIEW_NAME}:{c}" for c in sample_cols],
        entity_rows=[{"uid": sample_uid}],
    ).to_dict()
    logger.info(f"Online lookup for uid {sample_uid}: {online}")


if __name__ == "__main__":
    main()